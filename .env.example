# Path to music folder
# Windows: MUSIC_DIR=C:/Users/yourname/Music
# Linux:   MUSIC_DIR=/home/yourname/music
MUSIC_DIR=./music

# Long random string used to sign login tokens — never share this.
# Must be IDENTICAL to the JWT_SECRET in the quarc-auth service's .env
# (see the Quarc_Notes repo's auth/ folder) — that's what makes one login
# work across Quarc Music, Quarc Notes, and future Quarc apps.
JWT_SECRET=change-this-to-a-long-random-string

# Admin username (default: admin)
ADMIN_USERNAME=admin

# ADMIN_PASSWORD: intentionally left out.
# On first start, if this is not set, the backend auto-generates
# a random password and prints it ONCE in the logs:
#   docker compose logs backend
# After that, change it inside the app.

# Always true now — the app runs over HTTPS
SECURE_COOKIE=true

# Max download speed for yt-dlp (applies to all song downloads)
# Examples: 2M = 2 MB/s, 500K = 500 KB/s. Leave empty for unlimited.
YTDLP_RATE_LIMIT=2M

# Last.fm API key for the Radio feature (similar song suggestions)
# Get a free key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# VPN service credentials for routing downloads through gluetun (OpenVPN).
# Currently: ProtonVPN. Find these at account.proton.me → VPN →
# OpenVPN/IKEv2 username — this is NOT your regular Proton account login,
# it's a separate generated credential (mixing the two up produces an
# AUTH_FAILED loop in gluetun's logs that looks like a dead VPN but isn't).
# Named provider-neutrally (not VPN_USER/VPN_PASSWORD stayed the same
# across the Surfshark→ProtonVPN switch) so switching providers again later
# doesn't require renaming these — just regenerate credentials and swap
# VPN_SERVICE_PROVIDER in docker-compose.yml.
VPN_USER=
VPN_PASSWORD=

# VPN server country for downloads. Must be one gluetun/the provider
# actually has servers in — for ProtonVPN's FREE tier specifically, only:
# Canada, Japan, Mexico, Netherlands, Norway, Poland, Romania, Singapore,
# Switzerland, United States. (On a paid Proton plan, remove FREE_ONLY from
# docker-compose.yml and any of Proton's 145+ countries works.)
#
# If downloads start failing with "Sign in to confirm you're not a bot",
# try rotating this to another country before assuming it's a code problem
# — autoheal.sh does this automatically already, this is just for manual use.
VPN_COUNTRY=Switzerland
